<?xml version="1.0" encoding="utf-8"?>
<!-- Plain http only to the phone itself: a test's own account service, reached through
     "adb reverse tcp:8099 tcp:8099". Everything else is https, as the game insists anyway
     (Shared/Engine/Net/Https.cpp, url_allowed). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
